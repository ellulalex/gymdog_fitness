APP_NAME=Gymdog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gymdog.test

# Storefront theme served when a tenant sets none (see config/themes.php).
THEME_DEFAULT=gymdog

# Seeded staff login (database/seeders/DatabaseSeeder.php). Change on any
# non-local environment.
ADMIN_NAME="Alex Ellul"
ADMIN_EMAIL=alex@gymdog.fitness
ADMIN_PASSWORD=password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymdog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (test mode). Get these from the gymdog Stripe dashboard.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` or a dashboard endpoint.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Connect (leave empty for a direct charge on the platform account):
STRIPE_CONNECTED_ACCOUNT=
STRIPE_APPLICATION_FEE_BPS=0

# Content automation (Phase 4). Keep auto-publish off until output has earned it.
ANTHROPIC_API_KEY=
CONTENT_AUTO_PUBLISH=false
CONTENT_BRAKE_HOURS=24
CONTENT_NOTIFY_EMAIL="${ADMIN_EMAIL}"

VITE_APP_NAME="${APP_NAME}"
