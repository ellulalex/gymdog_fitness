APP_NAME=Gymdog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gymdog.test

# Storefront theme served when a tenant sets none (see config/themes.php).
THEME_DEFAULT=gymdog

# Seeded staff login (database/seeders/DatabaseSeeder.php). Change on any
# non-local environment.
ADMIN_NAME="Alex Ellul"
ADMIN_EMAIL=alex@gymdog.fitness
# Who gets the "new order" alert (comma-separate for several; empty = off).
ORDER_NOTIFY_EMAIL="${ADMIN_EMAIL}"
ADMIN_PASSWORD=password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymdog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Zoho Mail (same provider as the current gymdog.fitness site). MAIL_PASSWORD
# is a Zoho *app-specific password* for the noreply@ mailbox — enter it with any
# display spaces removed. Port 587 + STARTTLS because Hetzner blocks 465/25 on
# new servers. Use smtp.zoho.eu if the Zoho account is in the EU data centre.
# Locally, leave MAIL_MAILER=log to write mail to the log instead of sending.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=noreply@gymdog.fitness
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@gymdog.fitness"
MAIL_FROM_NAME="GymDog Fitness"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (test mode). Get these from the gymdog Stripe dashboard.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` or a dashboard endpoint.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Connect (leave empty for a direct charge on the platform account):
STRIPE_CONNECTED_ACCOUNT=
STRIPE_APPLICATION_FEE_BPS=0

# Content automation (Phase 4). Keep auto-publish off until output has earned it.
ANTHROPIC_API_KEY=
CONTENT_AUTO_PUBLISH=false
CONTENT_BRAKE_HOURS=24
CONTENT_NOTIFY_EMAIL="${ADMIN_EMAIL}"
# Auto-illustration for generated articles (free tiers). Optional — skipped if unset.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
CONTENT_IMAGE_PROVIDER=unsplash

VITE_APP_NAME="${APP_NAME}"
